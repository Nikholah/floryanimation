---
/**
 * Bloc Contact en bas de l'accueil (variant « accueil », id #contact)
 * et de la page Prestations (variant « prestations »).
 */
import { EMAIL, INSTAGRAM_URL, PHONE_HREF, PHONE_INTL } from '../lib/contact';
import { UI, type Lang } from '../i18n/ui';

interface Props {
    lang: Lang;
    variant: 'accueil' | 'prestations';
}

const { lang, variant } = Astro.props;
const t = UI[lang].contactSection;
---
{variant === 'accueil' ? (
    <section id="contact" class="contact">
        <div class="section">
            <h2>{t.title}</h2>
            <p>{t.intro}</p>
            <div class="contact-info">
                <div class="contact-item priority">
                    <h3><span aria-hidden="true">📞</span> {t.phone}</h3>
                    <p><a href={PHONE_HREF}>{PHONE_INTL}</a></p>
                </div>
                <div class="contact-item priority">
                    <h3>Instagram</h3>
                    <p><a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Flory Animation</a></p>
                </div>
                <div class="contact-item priority">
                    <h3><span aria-hidden="true">✉️</span> {t.email}</h3>
                    <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
                </div>
            </div>
        </div>
    </section>
) : (
    <section class="cta-section">
        <div class="cta-content">
            <h2>{t.title}</h2>
            <p><strong>{t.intro}</strong></p>
            <div class="contact-info">
                <div class="contact-item priority">
                    <h3><span aria-hidden="true">📞</span> {t.phone}</h3>
                    <p><a href={PHONE_HREF}>{PHONE_INTL}</a></p>
                </div>
                <div class="contact-item priority">
                    <h3>Instagram</h3>
                    <p><a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Flory Animation</a></p>
                </div>
                <div class="contact-item priority">
                    <h3><span aria-hidden="true">✉️</span> {t.email}</h3>
                    <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
                </div>
            </div>
        </div>
    </section>
)}
