---
import { Image } from 'astro:assets';
import instagram from '../assets/img/instagram.png';
import { INSTAGRAM_URL, PHONE_HREF, devisHref } from '../lib/contact';
import { UI, type Lang } from '../i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
---
<button class="back-to-top" id="backToTop" type="button" aria-label={t.backToTop}>↑</button>

<a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="instagram-float">
    <Image src={instagram} alt="Instagram" width={40} densities={[1, 2]} />
</a>

<!-- Barre d'action fixe en bas de l'écran (mobile et tablette, jusqu'à 1 100 px) -->
<div class="action-bar" role="region" aria-label={t.actionBar.region}>
    <a href={PHONE_HREF} class="action-bar-call"><span aria-hidden="true">📞</span> {t.actionBar.call}</a>
    <a href={devisHref(undefined, lang)} class="action-bar-devis">{t.actionBar.quote}</a>
</div>
