---
import { url } from '../lib/url';
import { PHONE_DISPLAY, PHONE_HREF } from '../lib/contact';

interface Props {
    /** Page courante : sert à construire les liens et à marquer l'onglet actif. */
    current: 'accueil' | 'prestations' | 'devis';
}

const { current } = Astro.props;
const onHome = current === 'accueil';
// Sur l'accueil, ancres locales (défilement fluide) ; ailleurs, liens vers l'accueil.
const home = (anchor: string) => (onHome ? `#${anchor}` : url(`index.html#${anchor}`));
const show = (anchor: string) => (current === 'prestations' ? `#${anchor}` : url(`spectacles.html#${anchor}`));

const prestations = [
    { anchor: 'bubble-magic-show', label: 'Bubble Magic Show' },
    { anchor: 'la-valise', label: 'La Valise' },
    { anchor: 'spectacles-thematiques', label: 'Spectacles thématiques' },
    { anchor: 'jardin-des-bulles', label: 'Le Jardin des Bulles' },
    { anchor: 'atelier-bulles', label: 'Atelier Bulles de Savon' },
    { anchor: 'mariage', label: 'Mariage' },
    { anchor: 'dans-ma-bulle', label: 'Dans ma bulle' },
    { anchor: 'infos-pratiques', label: 'Informations pratiques' },
];
---
<nav class="navbar" aria-label="Menu principal">
    <div class="nav-container">
        <a href={onHome ? '#accueil' : url('index.html')} class="logo">✨ Flory Animation</a>

        <!-- Bouton du menu mobile (visible sous 768 px) -->
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
            <span class="visually-hidden">Menu</span>
            <span class="nav-toggle-bar" aria-hidden="true"></span>
            <span class="nav-toggle-bar" aria-hidden="true"></span>
            <span class="nav-toggle-bar" aria-hidden="true"></span>
        </button>

        <ul class="nav-links" id="nav-links">
            <li><a href={onHome ? '#accueil' : url('index.html')}>Accueil</a></li>
            <li><a href={home('nous-connaitre')}>À propos</a></li>
            <li class="dropdown">
                <div class="dropdown-head">
                    <a href={url('spectacles.html')} class:list={{ active: current === 'prestations' }}>Prestations</a>
                    <button class="dropdown-toggle" type="button" aria-expanded="false" aria-controls="sous-menu-prestations">
                        <span class="visually-hidden">Afficher la liste des prestations</span>
                        <span class="dropdown-arrow" aria-hidden="true">▼</span>
                    </button>
                </div>
                <ul class="dropdown-content" id="sous-menu-prestations">
                    {prestations.map((p) => <li><a href={show(p.anchor)}>{p.label}</a></li>)}
                </ul>
            </li>
            <li><a href={home('contact')}>Contact</a></li>
        </ul>

        <!-- Téléphone (grand écran ; sur mobile et tablette, voir la barre d'action en bas) -->
        <a href={PHONE_HREF} class="nav-phone"><span aria-hidden="true">📞</span> {PHONE_DISPLAY}</a>
    </div>
</nav>
