---
/**
 * Carte d'une prestation (page Prestations, FR et EN).
 * Le texte descriptif est passé dans `text` (HTML autorisé).
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { devisHref, type PrestationId } from '../lib/contact';
import { UI, type Lang } from '../i18n/ui';

interface Visual {
    src: ImageMetadata;
    alt: string;
    /** Image verticale (affiche, portrait) : affichée sans recadrage. */
    portrait?: boolean;
}

interface Props {
    lang: Lang;
    id: string;
    title: string;
    /** Petite étiquette sous le titre, par exemple « Ambiance Cabaret ». */
    tag?: string;
    text: string;
    images?: Visual[];
    /** Infos factuelles affichées sous le texte (Public, Format…). */
    details?: readonly { readonly label: string; readonly value: string }[];
    /** Prestation présélectionnée dans le formulaire de devis. */
    devisId: PrestationId;
    reverse?: boolean;
}

const { lang, id, title, tag, text, images = [], details = [], devisId, reverse = false } = Astro.props;
const t = UI[lang];

// Version grand format pour la lightbox
const visuals = await Promise.all(
    images.map(async (img) => ({
        ...img,
        full: (await getImage({ src: img.src, width: Math.min(1600, img.src.width) })).src,
    })),
);
---
<article class:list={['spectacle-card', { reverse }]} id={id}>
    {visuals.length > 0 && (
        <div class:list={['spectacle-images', { 'spectacle-images--duo': visuals.length > 1 }]}>
            {visuals.map((v) => (
                <Image
                    src={v.src}
                    alt={v.alt}
                    width={v.portrait ? 480 : 600}
                    class:list={['spectacle-image', { portrait: v.portrait }]}
                    data-full={v.full}
                />
            ))}
        </div>
    )}
    <div class="spectacle-content">
        <h3>{title}</h3>
        {tag && <p class="spectacle-tag">{tag}</p>}

        <div class="spectacle-details">
            <div class="detail-content spectacle-text">
                <p set:html={text} />
            </div>

            {details.map((d) => (
                <div class="detail-item">
                    <div class="detail-label">{d.label}{lang === 'fr' ? ' :' : ':'}</div>
                    <div class="detail-content">{d.value}</div>
                </div>
            ))}

            <div class="spectacle-actions">
                <a href={devisHref(devisId, lang)} class="btn btn-marron">{t.prestation.quote}</a>
                <span class="price">{t.prestation.price}</span>
            </div>
        </div>
    </div>
</article>
