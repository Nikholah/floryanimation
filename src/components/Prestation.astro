---
/**
 * Carte d'une prestation (page Prestations).
 * Le texte descriptif est passé dans le slot par défaut.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { devisHref } from '../lib/contact';

interface Visual {
    src: ImageMetadata;
    alt: string;
    /** Image verticale (affiche, portrait) : affichée sans recadrage. */
    portrait?: boolean;
}

interface Props {
    id: string;
    title: string;
    /** Petite étiquette sous le titre, par exemple « Ambiance Cabaret ». */
    tag?: string;
    images?: Visual[];
    /** Infos factuelles affichées sous le texte (Public, Format…). */
    details?: { label: string; value: string }[];
    /** Nom utilisé dans l'objet de l'email de devis. */
    devisLabel?: string;
    reverse?: boolean;
}

const { id, title, tag, images = [], details = [], devisLabel = title, reverse = false } = Astro.props;

// Version grand format pour la lightbox
const visuals = await Promise.all(
    images.map(async (img) => ({
        ...img,
        full: (await getImage({ src: img.src, width: Math.min(1600, img.src.width) })).src,
    })),
);
---
<article class:list={['spectacle-card', { reverse }]} id={id}>
    {visuals.length > 0 && (
        <div class:list={['spectacle-images', { 'spectacle-images--duo': visuals.length > 1 }]}>
            {visuals.map((v) => (
                <Image
                    src={v.src}
                    alt={v.alt}
                    width={v.portrait ? 480 : 600}
                    class:list={['spectacle-image', { portrait: v.portrait }]}
                    data-full={v.full}
                />
            ))}
        </div>
    )}
    <div class="spectacle-content">
        <h3>{title}</h3>
        {tag && <p class="spectacle-tag">{tag}</p>}

        <div class="spectacle-details">
            <div class="detail-content spectacle-text">
                <slot />
            </div>

            {details.map((d) => (
                <div class="detail-item">
                    <div class="detail-label">{d.label} :</div>
                    <div class="detail-content">{d.value}</div>
                </div>
            ))}

            <slot name="extra" />

            <div class="price">Tarif : sur demande</div>
            <div>
                <a href={devisHref(devisLabel)} class="devis-button">Demander un devis</a>
            </div>
        </div>
    </div>
</article>
