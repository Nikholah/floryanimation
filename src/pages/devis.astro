---
import Base from '../layouts/Base.astro';
import '../styles/devis.css';
import { url } from '../lib/url';
import { EMAIL, PHONE_DISPLAY, PHONE_HREF, PRESTATIONS_DEVIS, WEB3FORMS_ACCESS_KEY } from '../lib/contact';
---
<Base
    current="devis"
    title="Demander un devis - Flory Animation"
    description="Demandez un devis gratuit pour un spectacle de magie et de bulles de savon, une animation ou un mariage avec Flory Animation, partout en France et à l'international."
>
    <main class="devis-page">
        <header class="devis-intro">
            <h1>Demander un devis</h1>
            <p>Parlez-nous de votre événement : nous vous répondons avec une proposition sur mesure. Le devis est gratuit.</p>
            <p class="devis-alt">
                Vous préférez nous parler ? <a href={PHONE_HREF}>📞 {PHONE_DISPLAY}</a>
                <span aria-hidden="true">·</span>
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </p>
        </header>

        <!--
            Envoi via Web3Forms (https://web3forms.com), compatible avec un hébergement statique.
            Sans JavaScript, le formulaire est envoyé directement à Web3Forms (page de confirmation de Web3Forms).
            Avec JavaScript, l'envoi se fait en arrière-plan et un message s'affiche ici.
            Si la clé n'est pas encore renseignée (src/lib/contact.ts), le script ouvre un email prérempli.
        -->
        <form
            id="devis-form"
            class="devis-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            data-access-key={WEB3FORMS_ACCESS_KEY}
            data-email={EMAIL}
        >
            <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY}>
            <input type="hidden" name="subject" value="Nouvelle demande de devis - site Flory Animation">
            <input type="hidden" name="from_name" value="Site Flory Animation">
            <!-- Piège à robots (honeypot) : doit rester vide -->
            <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true">

            <fieldset>
                <legend>Votre événement</legend>

                <div class="field">
                    <label for="type_client">Vous êtes <span class="req" aria-hidden="true">*</span></label>
                    <select id="type_client" name="Vous êtes" required>
                        <option value="">Choisir…</option>
                        <option>Collectivité (école, mairie, centre culturel, centre de loisirs…)</option>
                        <option>Entreprise / CSE</option>
                        <option>Particulier</option>
                        <option>Autre</option>
                    </select>
                </div>

                <div class="field">
                    <label for="prestation">Prestation souhaitée <span class="req" aria-hidden="true">*</span></label>
                    <select id="prestation" name="Prestation" required>
                        <option value="">Choisir…</option>
                        {PRESTATIONS_DEVIS.map((p) => <option>{p}</option>)}
                        <option>Je ne sais pas encore / plusieurs prestations</option>
                    </select>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="date">Date de l'événement</label>
                        <input type="date" id="date" name="Date de l'événement">
                    </div>
                    <div class="field">
                        <label for="lieu">Lieu (ville, pays) <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" id="lieu" name="Lieu" required autocomplete="address-level2" placeholder="Ex. : Lyon, France">
                    </div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="spectateurs">Nombre de spectateurs (environ)</label>
                        <input type="number" id="spectateurs" name="Nombre de spectateurs" min="1" inputmode="numeric">
                    </div>
                    <div class="field">
                        <label for="age">Âge du public</label>
                        <input type="text" id="age" name="Âge du public" placeholder="Ex. : enfants de 4 à 10 ans, adultes…">
                    </div>
                </div>

                <fieldset class="field radios">
                    <legend>Intérieur ou extérieur ?</legend>
                    <label><input type="radio" name="Lieu de la prestation" value="Intérieur"> Intérieur</label>
                    <label><input type="radio" name="Lieu de la prestation" value="Extérieur"> Extérieur</label>
                    <label><input type="radio" name="Lieu de la prestation" value="Je ne sais pas encore" checked> Je ne sais pas encore</label>
                </fieldset>
            </fieldset>

            <fieldset>
                <legend>Vos coordonnées</legend>

                <div class="field">
                    <label for="nom">Nom et prénom <span class="req" aria-hidden="true">*</span></label>
                    <input type="text" id="nom" name="name" required autocomplete="name">
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
                        <input type="email" id="email" name="email" required autocomplete="email">
                    </div>
                    <div class="field">
                        <label for="telephone">Téléphone</label>
                        <input type="tel" id="telephone" name="Téléphone" autocomplete="tel">
                    </div>
                </div>

                <div class="field">
                    <label for="message">Votre message</label>
                    <textarea id="message" name="message" rows="5" placeholder="Occasion, horaires, contraintes particulières…"></textarea>
                </div>
            </fieldset>

            <p class="rgpd">
                Les informations saisies servent uniquement à répondre à votre demande de devis. Elles sont transmises par email
                via le service Web3Forms et ne sont pas conservées sur ce site.
                <a href={url('confidentialite.html')}>En savoir plus sur vos données</a>.
            </p>
            <p class="req-note"><span aria-hidden="true">*</span> Champs obligatoires</p>

            <button type="submit" class="devis-submit">Envoyer ma demande</button>

            <div id="devis-status" class="devis-status" role="status" aria-live="polite"></div>
        </form>
    </main>
</Base>

<script>
    const form = document.getElementById('devis-form') as HTMLFormElement;
    const status = document.getElementById('devis-status') as HTMLElement;
    const submit = form.querySelector<HTMLButtonElement>('.devis-submit')!;
    const prestationSelect = form.querySelector<HTMLSelectElement>('#prestation')!;
    const message = form.querySelector<HTMLTextAreaElement>('#message')!;

    // Présélection de la prestation depuis l'URL : devis.html?prestation=La%20Valise
    const demandee = new URLSearchParams(location.search).get('prestation');
    if (demandee) {
        const option = [...prestationSelect.options].find((o) => o.value === demandee);
        if (option) {
            prestationSelect.value = demandee;
        } else {
            prestationSelect.value = 'Je ne sais pas encore / plusieurs prestations';
            message.value = `Prestation : ${demandee}\n`;
        }
    }

    function showStatus(type: 'success' | 'error' | 'info', text: string) {
        status.className = `devis-status devis-status--${type}`;
        status.textContent = text;
    }

    // Repli tant que la clé Web3Forms n'est pas renseignée : email prérempli avec toutes les réponses
    function openMailFallback(data: FormData) {
        const lines: string[] = [];
        data.forEach((value, key) => {
            if (['access_key', 'subject', 'from_name', 'botcheck'].includes(key)) return;
            if (String(value).trim()) lines.push(`${key} : ${value}`);
        });
        const subject = `Demande de devis : ${data.get('Prestation') ?? ''}`;
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
        showStatus('info', "Votre logiciel de messagerie va s'ouvrir avec votre demande : il ne reste qu'à l'envoyer.");
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;

        const data = new FormData(form);
        if (!form.dataset.accessKey) {
            openMailFallback(data);
            return;
        }

        submit.disabled = true;
        showStatus('info', 'Envoi en cours…');
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: { Accept: 'application/json' },
                body: data,
            });
            const result = await response.json();
            if (response.ok && result.success) {
                form.reset();
                showStatus('success', 'Merci ! Votre demande a bien été envoyée. Nous revenons vers vous très vite.');
            } else {
                throw new Error(result.message);
            }
        } catch {
            showStatus('error', `L'envoi n'a pas abouti. Vous pouvez réessayer, ou nous écrire directement à ${form.dataset.email}.`);
        } finally {
            submit.disabled = false;
        }
    });
</script>
