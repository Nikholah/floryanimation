---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/index.css';
import { url } from '../lib/url';

import floryAnne from '../assets/img/FLORY_ANNE.jpg';
import famille from '../assets/img/famille.jpg';
import licorne from '../assets/img/LA_LICORNE.jpg';
import poule from '../assets/img/LA_POULE.jpg';
import clown from '../assets/img/LE_CLOWN.jpg';
import nounours from '../assets/img/NOUNOURS.jpg';
import sapin from '../assets/img/SAPIN_DE_NOEL.jpg';

const mascottes = [
    { img: licorne, alt: 'Mascotte Licorne', title: '🦄 La Licorne' },
    { img: poule, alt: 'Mascotte Poule', title: '🐔 La Poule' },
    { img: clown, alt: 'Mascotte Clown', title: '🤡 Le Clown' },
    { img: nounours, alt: 'Mascotte Nounours', title: '🧸 Le Nounours' },
    { img: sapin, alt: 'Mascotte Sapin de Noël', title: '🎄 Le Sapin de Noël' },
];
---
<Base
    current="accueil"
    title="MAGIE – ANIMATION INTERGENERATIONNELLE"
    description="Découvrez Flory Animation, spécialiste des spectacles magiques et animations intergénérationnelles. Réservez des moments inoubliables pour toute la famille."
    keywords="magie, animation, spectacles, intergénérationnel, mascottes, Flory Animation"
>
    <!-- Hero Section -->
    <section id="accueil" class="hero">
        <div class="hero-content">
            <h1>Flory Animation vous invite à découvrir son univers enchanté...</h1>
            <a href={url('spectacles.html')} class="cta-button">Découvrir nos prestations</a>

            <div class="hero-lists">
                <div class="hero-list-item">
                    <h3>Collectivité</h3>
                    <ul>
                        <li>École, Mairie</li>
                        <li>Centre Culturel</li>
                        <li>Centres de Loisirs...</li>
                    </ul>
                </div>

                <div class="hero-list-item">
                    <h3>Événementiel</h3>
                    <ul>
                        <li>Soirée d'entreprise</li>
                        <li>Arbre de Noël...</li>
                    </ul>
                </div>

                <div class="hero-list-item">
                    <h3>Particulier</h3>
                    <ul>
                        <li>Mariage</li>
                        <li>Anniversaire...</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Nous Connaître -->
    <section id="nous-connaitre" class="section">
        <h2>À propos de Flory Animation</h2>
        <div class="about-content">
            <div class="about-text">
                <div class="first-paragraph">
                    <Image src={floryAnne} alt="Flory Anne - Artiste magicienne" class="flory-anne-image" width={120} height={150} densities={[1, 2]} fit="cover" />
                    <p><strong>Flory Animation</strong>, c'est avant tout une histoire de passion et de transmission. Fondée par <strong>Flory Anne</strong>, fille de magiciens, l'univers du spectacle a bercé son enfance. Dès l'âge de 6 ans, elle fait ses premiers pas sur scène, tout en débutant des cours de danse classique et de piano.</p>
                </div>

                <p>À 14 ans, elle présente son premier numéro de magie en solo et parcourt la France, affirmant peu à peu son identité artistique. Sa rencontre marquante avec <strong>Annie Fratellini</strong> la plonge dans le monde du cirque, enrichissant sa palette avec l'acrobatie, la jonglerie et l'expression scénique.</p>

                <p>Plus tard, une formation auprès des professeurs du <strong>Cirque de Pékin</strong> vient parfaire sa rigueur et sa maîtrise du mouvement. Inspiré par l'imaginaire des dessins animés et l'élégance rétro des années 50, son personnage naît comme une silhouette hors du temps.</p>

                <p>Au fil des années, elle le sculpte, le réinvente, l'habille de nuances nouvelles. De scène en scène,<br>il devient le fil rouge d'un univers singulier qu'elle décline avec poésie.</p>

                <p>Sa plus belle création reste sa propre famille. Flory Anne devient maman en 1995, puis en 1999.<br>Deux sources d'inspiration qui enrichissent profondément son univers artistique et personnel.</p>

                <div class="duo-paragraphs reverse">
                    <Image src={famille} alt="Flory Animation - Duo artistique" class="duo-image" width={178} densities={[1, 2]} />
                    <div class="duo-text">
                        <p>Aujourd'hui, <strong>Flory Animation</strong> est bien plus qu'une compagnie artistique : c'est une aventure familiale, portée par la passion, la transmission et la joie de créer pour émerveiller petits et grands.</p>
                        <p>Leur plus grand bonheur ? <strong>Partager avec vous la magie de leurs créations.</strong></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Mascottes Carousel -->
    <section id="mascottes" class="section">
        <h2>Mascottes</h2>
        <div class="carousel-container">
            <div class="carousel-track" id="carouselTrack">
                {mascottes.map((m, i) => (
                    <div class="carousel-slide">
                        <Image src={m.img} alt={m.alt} class="mascot-image" width={375} densities={[1, 2]} loading={i === 0 ? 'eager' : 'lazy'} />
                        <div class="mascot-content">
                            <h3>{m.title}</h3>
                            <p>Prestation en complément d'une animation.<br>Personnage pour accueillir votre public.</p>
                            <p><strong>Tarif : sur demande</strong></p>
                        </div>
                    </div>
                ))}
            </div>

            <button class="carousel-nav prev" type="button" aria-label="Mascotte précédente">‹</button>
            <button class="carousel-nav next" type="button" aria-label="Mascotte suivante">›</button>
        </div>

        <div class="carousel-indicators">
            {mascottes.map((m, i) => (
                <button class:list={['indicator', { active: i === 0 }]} type="button" data-slide={i} aria-label={`Afficher ${m.alt}`}></button>
            ))}
        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact">
        <div class="section">
            <h2>Contact</h2>
            <p>Contactez-nous pour transformer votre projet en une réalité magique.</p>

            <div class="contact-info">
                <div class="contact-item priority">
                    <h3>📞 Téléphone</h3>
                    <p><a href="tel:+33667785419">+33 6 67 78 54 19</a></p>
                </div>
                <div class="contact-item priority">
                    <h3> Instagram</h3>
                    <p><a href="https://www.instagram.com/floryanimation/">Flory Animation</a></p>
                </div>
                <div class="contact-item priority">
                    <h3>✉️ Email</h3>
                    <p><a href="mailto:floryanimation@free.fr">floryanimation@free.fr</a></p>
                </div>
            </div>
        </div>
    </section>
</Base>

<script>
    // Carrousel des mascottes
    const track = document.getElementById('carouselTrack');
    const indicators = document.querySelectorAll<HTMLButtonElement>('.indicator');
    const totalSlides = indicators.length;
    let currentSlide = 0;

    function goToSlide(index: number) {
        currentSlide = (index + totalSlides) % totalSlides;
        if (track) track.style.transform = `translateX(-${currentSlide * 100}%)`;
        indicators.forEach((indicator, i) => indicator.classList.toggle('active', i === currentSlide));
    }

    document.querySelector('.carousel-nav.prev')?.addEventListener('click', () => goToSlide(currentSlide - 1));
    document.querySelector('.carousel-nav.next')?.addEventListener('click', () => goToSlide(currentSlide + 1));
    indicators.forEach((indicator) => {
        indicator.addEventListener('click', () => goToSlide(Number(indicator.dataset.slide)));
    });

    // Défilement automatique toutes les 5 secondes
    setInterval(() => goToSlide(currentSlide + 1), 5000);
</script>
