---
/**
 * Page « Laisser un avis », commune au français (src/pages/avis.astro) et à l'anglais (src/pages/en/review.astro).
 * Textes : src/i18n/avis.ts. Mise en forme partagée avec le formulaire de devis (devis.css).
 * Comme pour le devis, les noms de champs et les valeurs envoyés restent en français.
 */
import Base from '../layouts/Base.astro';
import '../styles/devis.css';
import { EMAIL, GOOGLE_REVIEW_URL, PRESTATIONS_DEVIS, WEB3FORMS_ACCESS_KEY } from '../lib/contact';
import { pageUrl, type Lang } from '../i18n/ui';
import { AVIS } from '../i18n/avis';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = AVIS[lang];
---
<Base lang={lang} page="avis" title={t.title} description={t.description}>
    <main class="devis-page">
        <header class="devis-intro">
            <h1>{t.h1}</h1>
            <p>{t.intro}</p>
            {GOOGLE_REVIEW_URL && (
                <p class="devis-alt">
                    <a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener noreferrer">{t.google}</a>
                </p>
            )}
        </header>

        <form
            id="avis-form"
            class="devis-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            data-access-key={WEB3FORMS_ACCESS_KEY}
            data-email={EMAIL}
            data-msg-sending={t.msgSending}
            data-msg-success={t.msgSuccess}
            data-msg-error={t.msgError}
            data-msg-mail={t.msgMail}
            data-mail-subject={t.mailSubject}
        >
            <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY}>
            <input type="hidden" name="subject" value="Nouvel avis client - site Flory Animation">
            <input type="hidden" name="from_name" value="Site Flory Animation">
            <input type="hidden" name="Langue du visiteur" value={lang === 'fr' ? 'Français' : 'Anglais'}>
            <!-- Piège à robots (honeypot) : doit rester vide -->
            <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true">

            <div class="field">
                <label for="nom">{t.name} <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="nom" name="name" required autocomplete="given-name">
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="structure">{t.org}</label>
                    <input type="text" id="structure" name="Structure ou événement" placeholder={t.orgPlaceholder}>
                </div>
                <div class="field">
                    <label for="prestation">{t.prestation}</label>
                    <select id="prestation" name="Prestation">
                        <option value="">{t.choose}</option>
                        {PRESTATIONS_DEVIS.map((p) => <option value={p.fr}>{p[lang]}</option>)}
                    </select>
                </div>
            </div>

            <fieldset class="field radios">
                <legend>{t.ratingLegend}</legend>
                {t.ratingStars.map((label, i) => (
                    <label><input type="radio" name="Note" value={`${5 - i}/5`}> {label}</label>
                ))}
            </fieldset>

            <div class="field">
                <label for="message">{t.message} <span class="req" aria-hidden="true">*</span></label>
                <textarea id="message" name="message" rows="5" required placeholder={t.messagePlaceholder}></textarea>
            </div>

            <div class="field">
                <label for="email">{t.email}</label>
                <input type="email" id="email" name="email" autocomplete="email">
            </div>

            <label class="consent">
                <input type="checkbox" name="Publication autorisée" value="Oui">
                <span>{t.consent}</span>
            </label>

            <p class="rgpd">
                {t.rgpd}{' '}
                <a href={pageUrl('confidentialite', lang)}>{t.rgpdLink}</a>.
            </p>
            <p class="req-note"><span aria-hidden="true">*</span> {t.required}</p>

            <button type="submit" class="devis-submit">{t.submit}</button>

            <div id="avis-status" class="devis-status" role="status" aria-live="polite"></div>
        </form>
    </main>
</Base>

<script>
    import { setupForm } from '../scripts/form';

    setupForm(
        document.getElementById('avis-form') as HTMLFormElement,
        document.getElementById('avis-status') as HTMLElement,
    );
</script>
